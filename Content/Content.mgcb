
#----------------------------- Global Properties ----------------------------#

/outputDir:bin/$(Platform)
/intermediateDir:obj/$(Platform)
/platform:DesktopGL
/config:
/profile:Reach
/compress:False

# ---- shader ----

#begin Terrain.fx
/importer:EffectImporter
/processor:EffectProcessor
/build:Terrain.fx

#begin ShadowMap.fx
/importer:EffectImporter
/processor:EffectProcessor
/build:ShadowMap.fx

#begin Unit.fx
/importer:EffectImporter
/processor:EffectProcessor
/build:Unit.fx

# ---- textures ----

#begin terrainTileSheet.png
/importer:TextureImporter
/processor:TextureProcessor
/build:terrainTileSheet.png

#begin actionIcons.png
/importer:TextureImporter
/processor:TextureProcessor
/build:actionIcons.png

# ---- fonts ----

#begin DebugFont.spritefont
/importer:FontDescriptionImporter
/processor:FontDescriptionProcessor
/build:DebugFont.spritefont

#begin TooltipFont.spritefont
/importer:FontDescriptionImporter
/processor:FontDescriptionProcessor
/build:TooltipFont.spritefont


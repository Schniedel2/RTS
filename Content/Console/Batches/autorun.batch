# Lokale Bewegungs-Testszene: Fahrzeuge einzeln um die beiden Reaktoren
# schicken und besonders Wendungen dicht an den Gebäudeecken prüfen.
session-open movement-validation-local
disable Fogofwar
disable Hide-unexplored
enable Unitcommands
enable Gamegrid

# Startreihe: Tank, Harvester und Bulldozer.
spawn jeep 110 100 0
spawn tank 119 100 0
spawn harvester 128 100 0
spawn gdi-bulldozer 137 100 0
spawn motorbike 145 100 0

# Zwei feste Hindernisse für enge Kurven und Wendemanöver.
spawn reaktor 128 88 0
spawn reaktor 128 112 0
